{
  "name": "bench-extension-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit and SDK for Bench extensions",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "extensions:create": "node scripts/create-extension.mjs",
    "extensions:pack": "node scripts/pack-extension.mjs",
    "build:example": "pnpm --filter @bench/example build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && pnpm run typecheck",
    "verify": "pnpm run lint && pnpm run test && pnpm run build:example"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "i18next": "^26.5.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
