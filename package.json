{
  "name": "bench-extension-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit and SDK for Bench extensions",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "extensions:create": "node scripts/create-extension.mjs",
    "extensions:pack": "node scripts/pack-extension.mjs",
    "build:example": "pnpm --filter @bench/example build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && pnpm run typecheck",
    "verify": "pnpm run lint && pnpm run test && pnpm run build:example"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  }
}
